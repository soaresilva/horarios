# Pinned to UTC — see the comment in .env / src/lib/prisma.ts for why this matters.
TZ="UTC"

DATABASE_URL="postgresql://user@localhost:5432/horarios_dev?schema=public"

# Shared password for the /admin panel (single trusted admin, no user accounts).
ADMIN_PASSWORD="changeme"

# Signs the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="generate-a-real-secret-with-openssl-rand--base64-32"
