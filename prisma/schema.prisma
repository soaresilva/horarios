// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// How a festival's timetable is drawn. Paredes de Coura has two stages and
// reads well as columns with time running down; Left of the Dial has ~26
// rooms, which only fit as rows with time running across.
enum TimetableLayout {
  VERTICAL
  TRANSPOSED
}

// One festival edition (Paredes de Coura 2026, Left of the Dial 2026, ...).
// Each gets its own public route at /<slug> and admin route at
// /admin/<slug>; there is no `archived` column — a festival reads as past
// once `endDate` has gone by (see isFestivalOver in src/lib/festival.ts),
// so nothing needs remembering to flip a flag when an edition wraps up.
model Festival {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  location  String
  startDate DateTime        @db.Date
  endDate   DateTime        @db.Date
  layout    TimetableLayout @default(VERTICAL)
  // BCP-47 tag for weekday abbreviations and clock formatting. "pt-PT" keeps
  // the Portuguese QUA/QUI/SEX labels matching bolachas.org's own timetable;
  // any other locale falls through to Intl's short weekday (see
  // formatDayTabLabel in src/lib/time.ts).
  locale    String          @default("pt-PT")
  // IANA zone (e.g. "Europe/Lisbon", "Europe/Amsterdam") every performance
  // time for this festival is anchored to, regardless of a viewer's or
  // admin's own device timezone.
  timezone  String
  stages    Stage[]
  zones     Zone[]
  artists   Artist[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
}

// A cluster of venues close enough together that walking between them is
// trivial. Timetable rows are grouped by zone so the venue axis doubles as a
// map of the city — at a 26-room festival spread across Rotterdam, "can I
// physically get there" matters as much as "is there a clash".
model Zone {
  id                 String     @id @default(cuid())
  festivalId         String
  festival           Festival   @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  name               String
  slug               String
  order              Int        @default(0)
  /// Approximate walking minutes from the festival's hub — for Left of the
  /// Dial, the Eendrachtsplein ticket desk.
  walkMinutesFromHub Int?
  stages             Stage[]
  walksFrom          ZoneWalk[] @relation("ZoneWalkFrom")
  walksTo            ZoneWalk[] @relation("ZoneWalkTo")

  @@unique([festivalId, slug])
  @@index([festivalId, order])
}

// Approximate walking minutes between two zones, stored once per unordered
// pair; walkMinutesBetween() in src/lib/zones.ts normalises the direction so
// callers never care which way round it was written.
//
// Deliberately a pair table rather than something derived from
// walkMinutesFromHub: two zones both 10 minutes from the hub can be 1 minute
// or 20 minutes from each other, so |a - b| is geometrically wrong and would
// mislead exactly the decision this exists to support.
model ZoneWalk {
  id         String @id @default(cuid())
  fromZoneId String
  fromZone   Zone   @relation("ZoneWalkFrom", fields: [fromZoneId], references: [id], onDelete: Cascade)
  toZoneId   String
  toZone     Zone   @relation("ZoneWalkTo", fields: [toZoneId], references: [id], onDelete: Cascade)
  minutes    Int

  @@unique([fromZoneId, toZoneId])
}

// Per-festival artist reference data, populated by scripts/import-lotd.ts
// from the festival's own act pages. Scoped to one festival: an act playing
// two different festivals gets a row per edition rather than a shared
// identity nobody maintains.
//
// Paredes de Coura does NOT use this table — its links stay hand-written and
// hand-verified in src/lib/artist-links.ts (see the sourcing rules at the top
// of that file). Don't migrate them.
model Artist {
  id           String        @id @default(cuid())
  festivalId   String
  festival     Festival      @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  /// Source-site slug ("al-cologne-uk"): the stable join key across importer
  /// runs, since a display name can be re-typed but the URL is the record.
  slug         String
  name         String
  /// As published: "UK", "AU", occasionally "FR/UK".
  country      String?
  /// As published, slash-separated: "folk / indie pop / pop".
  genres       String?
  spotifyUrl   String?
  instagramUrl String?
  /// The act's page on the festival's own site, linked from the artist name.
  sourceUrl    String?
  performances Performance[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  @@unique([festivalId, slug])
}

// A stage/venue that hosts performances on one or more festival dates,
// scoped to a single festival — a slug like "main-stage" may legitimately
// exist in more than one festival, so uniqueness is per-festival, not
// global. `order` decides display priority within a given date: the two
// lowest `order` values active on a "main" date render as the side-by-side
// grid, any others (e.g. a pre-festival or free-programme stage) surface in
// the "other stages" tab for that date.
model Stage {
  id           String        @id @default(cuid())
  festivalId   String
  festival     Festival      @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  /// Which walking cluster this room sits in. Null for festivals that don't
  /// need zones (Paredes de Coura is one site), so the vertical layout never
  /// reads it.
  zoneId       String?
  zone         Zone?         @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  name         String
  slug         String
  /// Street address, used to build a Google Maps link from the venue name in
  /// the timetable. Rooms sharing a building (Worm 1/2, the three Theater
  /// Rotterdam rooms) simply repeat it — not worth a Venue entity for one
  /// string.
  address      String?
  order        Int           @default(0)
  performances Performance[]
  updatedAt    DateTime      @default(now()) @updatedAt

  @@unique([festivalId, slug])
  @@index([festivalId, order])
  @@index([festivalId, zoneId, order])
}

model Performance {
  id          String   @id @default(cuid())
  artistName  String
  date        DateTime @db.Date
  // @db.Timestamptz, not the Prisma default (timestamp without time zone):
  // node-postgres serializes plain `timestamp` columns using the Node
  // process's local timezone getters, so the naive value stored would
  // silently depend on the server's TZ env var. Timestamptz always stores
  // and returns a real UTC instant regardless of the process timezone.
  startTime   DateTime @db.Timestamptz
  endTime     DateTime @db.Timestamptz
  notes       String?
  // Admin-curated "bolachas recommends" flag, surfaced on the public page as
  // a small blue thumbs-up after the artist name (see PerformanceBlock /
  // SideStageSection). Distinct from a viewer's client-side "starred"
  // favourites, which live in localStorage, never the DB.
  recommended Boolean  @default(false)
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  /// Optional enrichment link to imported reference data (bio links, country,
  /// the act's own page). Nullable because Paredes de Coura has no Artist
  /// rows, and SetNull rather than Cascade because deleting an artist must
  /// never delete a scheduled set. `artistName` stays the source of truth for
  /// what's displayed and what the admin form edits.
  artistId    String?
  artist      Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)
  favorites   Favorite[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date, stageId])
  @@index([artistId])
}

// A visitor's server-synced star on one performance, written only once a
// visitor has explicitly opted into cross-device sync (see src/lib/visitor.ts
// and src/app/favorites/actions.ts) — a visitor who never opts in leaves no
// row here at all, favorites stay purely in localStorage (src/hooks/useStarred.ts).
// `visitorId` is a bare opaque string (an httpOnly cookie value), not an FK to
// a Visitor table: this app deliberately has no accounts, so there is nothing
// else to model a visitor as. Cascades on Performance deletion — nothing
// should stay "starred" once the set itself no longer exists.
model Favorite {
  id            String      @id @default(cuid())
  visitorId     String
  performanceId String
  performance   Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([visitorId, performanceId])
  @@index([visitorId])
}

// A short-lived, single-use code that lets a second device adopt the
// generating device's visitorId, syncing both to the same Favorite rows
// going forward. No rate-limiting table behind this by design — see the
// plan doc for cross-device favorites sync for the reasoning (worst case of
// a guessed code is a stranger seeing another stranger's starred shows, not
// a sensitive resource).
model PairingCode {
  id         String    @id @default(cuid())
  code       String    @unique
  visitorId  String
  expiresAt  DateTime
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}
